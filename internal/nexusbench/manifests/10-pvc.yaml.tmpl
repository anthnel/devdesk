apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: nexus-data
  namespace: {{ q .Namespace }}
  labels:
    app.kubernetes.io/name: nexus
    app.kubernetes.io/managed-by: devdesk-nexus-bench
    app.kubernetes.io/part-of: devdesk-nexus-bench
spec:
  accessModes:
    - ReadWriteOnce
  resources:
    requests:
      storage: {{ q .StorageSize }}

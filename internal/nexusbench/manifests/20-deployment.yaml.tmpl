apiVersion: apps/v1
kind: Deployment
metadata:
  name: nexus
  namespace: {{ q .Namespace }}
  labels:
    app.kubernetes.io/name: nexus
    app.kubernetes.io/managed-by: devdesk-nexus-bench
    app.kubernetes.io/part-of: devdesk-nexus-bench
spec:
  replicas: 1
  # One ReadWriteOnce volume: the old pod must release it before the new one starts.
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/name: nexus
  template:
    metadata:
      labels:
        app.kubernetes.io/name: nexus
        app.kubernetes.io/managed-by: devdesk-nexus-bench
        app.kubernetes.io/part-of: devdesk-nexus-bench
    spec:
      automountServiceAccountToken: false
      enableServiceLinks: false
      containers:
        - name: nexus
          image: {{ q .Image }}
          env:
            - name: INSTALL4J_ADD_VM_PARAMS
              value: {{ q .JVMOpts }}
          ports:
            - name: http
              containerPort: 8081
            - name: docker-group
              containerPort: 8082
          resources:
            requests:
              cpu: {{ q .CPURequest }}
              memory: {{ q .MemoryRequest }}
            limits:
              cpu: {{ q .CPULimit }}
              memory: {{ q .MemoryLimit }}
          # UID and GID 200 are the nexus user of the image.
          securityContext:
            runAsUser: 200
            runAsGroup: 200
            runAsNonRoot: true
            allowPrivilegeEscalation: false
            capabilities:
              drop:
                - ALL
            seccompProfile:
              type: RuntimeDefault
          volumeMounts:
            - name: nexus-data
              mountPath: /nexus-data
          # Nexus takes minutes to start: wait up to 10 minutes (60 x 10 s).
          # There is no livenessProbe: a restart during the first start would loop.
          startupProbe:
            httpGet:
              path: /service/rest/v1/status
              port: http
            periodSeconds: 10
            timeoutSeconds: 5
            failureThreshold: 60
          readinessProbe:
            httpGet:
              path: /service/rest/v1/status
              port: http
            periodSeconds: 10
            timeoutSeconds: 5
            failureThreshold: 3
      volumes:
        - name: nexus-data
          persistentVolumeClaim:
            claimName: nexus-data

apiVersion: v1
kind: Service
metadata:
  name: nexus
  namespace: {{ q .Namespace }}
  labels:
    app.kubernetes.io/name: nexus
    app.kubernetes.io/managed-by: devdesk-nexus-bench
    app.kubernetes.io/part-of: devdesk-nexus-bench
spec:
  type: NodePort
  selector:
    app.kubernetes.io/name: nexus
  ports:
    # REST API, UI and path routing.
    - name: http
      port: 8081
      targetPort: http
      nodePort: {{ .HTTPNodePort }}
    # HTTP connector of the Docker group repository.
    - name: docker-group
      port: 8082
      targetPort: docker-group
      nodePort: {{ .DockerNodePort }}

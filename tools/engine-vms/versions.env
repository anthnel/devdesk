# Pinned engine matrix for the disposable test VMs (OC-85, DEVDESK-795).
# Chosen 2026-11-26 from the official release feeds. "N" is the latest stable
# line, "N-1" the previous one (previous major for Docker and Podman, previous
# minor for kind). Bump here, run `create.sh` on fresh VMs, then `verify.sh`.
#
# Sourced by bash on the dev machine and inside the VMs: plain VAR=value only.

# Docker Engine, apt package version from download.docker.com (Ubuntu noble).
DOCKER_N=5:29.10.1-1~ubuntu.24.04~noble   # released 2026-11-24
DOCKER_N1=5:28.5.2-1~ubuntu.24.04~noble   # latest 28.x
DOCKER_N_VERSION=29.10.1
DOCKER_N1_VERSION=28.5.2

# Podman, full static build (github.com/mgoltzsche/podman-static), sha256 of the amd64 tarball.
PODMAN_N_VERSION=6.2.1                    # released 2026-11-24
PODMAN_N_SHA256=e95435d3ad37be41ec00a6b10ea5063563c9f8b485da47fbb1cbc21eb102464f
PODMAN_N1_VERSION=5.8.11                  # latest 5.x
PODMAN_N1_SHA256=52803062a9669ac11c2ab4666bc9ec84c53b940e0228c8a651ecf9926ec16486

# kind (kubernetes-sigs/kind release binaries, sha256 from the release).
KIND_N_VERSION=0.33.0                     # released 2026-08-26
KIND_N_SHA256=aee6151561422756b764a4ae28e7f44cda5af5a9eead3cc9985112b1de8d8e0d
KIND_N1_VERSION=0.32.0                    # released 2026-06-02
KIND_N1_SHA256=50030de23cf40a18505f20426f6a8506bedf13c6e509244bd1fa9463721b0f54
# Node images pinned by digest, as published in the kind release notes.
KIND_N_NODE=kindest/node:v1.37.0@sha256:a1ed56cfb0e7b93589bdf97c8cd566405a265939e3620fc4f5de89adff580ae5
KIND_N1_NODE=kindest/node:v1.36.1@sha256:3489c7674813ba5d8b1a9977baea8a6e553784dab7b84759d1014dbd78f7ebd5

# kubectl (dl.k8s.io), within one minor of both node images.
KUBECTL_VERSION=1.37.3
KUBECTL_SHA256=9a1b55af2795b25dd288dbef62387db9b5530087ab918d28c6ad067f2e3cb07c

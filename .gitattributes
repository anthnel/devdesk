# Normalize line endings to LF in the repository; checkout as-is on all platforms.
* text=auto eol=lf

# Binaries — no line-ending conversion.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.svg  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.eot  binary
*.zip  binary
*.tar  binary
*.gz   binary

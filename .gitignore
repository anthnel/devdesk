# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/
dist/
devdesk

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out
coverage.txt
coverage.html

# Go workspace file
go.work

# Dependency directories
vendor/

# Git worktrees. They live inside the repository so that a direct-mode sandbox,
# which mounts this directory only, shares their files with the host — a sibling
# path would put them in the container's private layer. The leading dot keeps
# them out of `go build ./...` and `go test ./...`, which skip directories
# beginning with "." or "_". See .claude/CLAUDE.md.
.worktrees/

# Build artifacts
build/
target/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Environment and secrets
.env
.env.local
*.pem
*.key
credentials.json

# Logs
*.log
debug.log

# OS files
Thumbs.db

# User config (stored in ~/.devdesk/)
config.yaml

# Temporary files
tmp/
temp/

.sbx/